{
  "manifest_version": 3,
  "name": "Leet Blind",
  "description": "Hides/Randomizes the difficulty of leetcode problems",
  "version": "1.0",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.com/problemset/"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Leet Blind",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"]
}
